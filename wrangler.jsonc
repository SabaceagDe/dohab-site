{
  // Déploiement Cloudflare Workers.
  // - Les pages publiques sont des fichiers statiques servis depuis ./dist.
  // - Le Worker (code généré par Astro) ne sert que /admin/* : suivi des
  //   paiements, export CSV, page de calcul.
  "name": "dohab-site",
  "compatibility_date": "2026-09-11",
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  // Le Worker ne doit être joignable QUE via dohab.be, où Cloudflare Access
  // protège /admin. L'adresse *.workers.dev et les URL de preview
  // contourneraient Access : on les coupe.
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dohab-db",
      "database_id": "5fd75a21-97e6-465f-a6bd-33711c110af7",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Access (Zero Trust → Access → Applications → l'app "admin").
  // Le middleware vérifie la signature du jeton Access sur chaque requête
  // /admin : sans ces deux valeurs, /admin refuse tout en production.
  "vars": {
    // ex. "https://dohab.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // "Application Audience (AUD) Tag" de l'application Access
    "ACCESS_AUD": ""
  }
}
