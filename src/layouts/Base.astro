---
import '../styles/tokens.css';
import '../styles/global.css';
import { site, type Locale } from '../site.config';
import { t, locales, localeHref, legalHref } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  page?: 'home' | 'legal';
}
const { locale, title, description, page = 'home' } = Astro.props;
const tr = t(locale);

const pageTitle = title ?? `${site.name} — ${tr('hero.eyebrow')}`;
const pageDesc = description ?? tr('hero.sub');

// L'équivalent de CETTE page dans chaque langue — pas l'accueil.
const versLangue = page === 'legal' ? legalHref : localeHref;
const canonique = new URL(versLangue(locale), Astro.site);

// Aperçu de partage. Sans ces balises, un lien collé dans WhatsApp ou
// Messenger arrive nu : juste l'adresse, aucune image, aucun titre. Pour
// une entreprise dont les clients s'échangent des liens par téléphone,
// c'est la première impression qui se joue là.
const ogLocale = { nl: 'nl_BE', fr: 'fr_BE', en: 'en_GB' }[locale];
const carte = new URL('/social-card.jpg', Astro.site).href;

// Fiche Schema.org : c'est ce que Google lit pour afficher l'entreprise
// dans son panneau de droite et sur Maps. Les horaires restent à ajouter
// le jour où le patron les fixe : openingHours: ['Mo-Sa 08:00-18:00'].
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: new URL(localeHref(locale), Astro.site).href,
  image: new URL('/social-card.jpg', Astro.site).href,
  vatID: site.vat,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.postcode,
    addressLocality: site.city,
    addressCountry: site.country
  },
  areaServed: site.areaServed,
  vatID: site.vat
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />

    {/* Un SVG suffit : tous les navigateurs actuels le lisent, et il
        reste net sur un écran Retina comme dans un onglet épinglé.
        Sans cette ligne, chaque visite déclenche un 404 sur
        /favicon.ico que le navigateur demande tout seul. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#5D6E51" />

    <link rel="canonical" href={canonique} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={carte} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {locales.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate"
            content={{ nl: 'nl_BE', fr: 'fr_BE', en: 'en_GB' }[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />

    {/* hreflang : dit à Google que ces trois pages sont la même page,
        dans trois langues. Sur les mentions légales, ce sont bien les
        trois pages de mentions légales qui se répondent. */}
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(versLangue(l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(versLangue('nl'), Astro.site)} />

    {/* La police est servie depuis notre propre domaine (public/fonts).
        Passer par Google enverrait l'adresse IP de chaque visiteur chez eux,
        ce qui demanderait une bannière de consentement pour rien.
        Les deux graisses de tête sont préchargées ; les autres suivent. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/figtree-latin-400-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/figtree-latin-300-normal.woff2" />

    {page === 'home' && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <slot />

    <script>
      // Apparitions au défilement. Le voile est posé sur l'image et non sur
      // son conteneur : un conteneur découpé a une surface nulle et
      // l'IntersectionObserver ne le voit jamais passer.
      const items = document.querySelectorAll('.rv, .rv-img');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
