---
// Calcul rapide d'un prix de vente. Outil interne, derrière Cloudflare
// Access comme tout /admin. Rien n'est stocké ni envoyé : tout se calcule
// dans le navigateur (script en bas de page).
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
---
<Admin title="Calcul de prix" active="calcul">
  <h1>Calcul de prix</h1>

  <div class="calc">
    <section class="card">
      <div class="types" role="group" aria-label="Type de calcul">
        <button type="button" data-type="1" aria-pressed="true">
          <strong>Type 1</strong>
          <span>Marge sur le matériel et sur le total</span>
        </button>
        <button type="button" data-type="2" aria-pressed="false">
          <strong>Type 2</strong>
          <span>Marge sur le total seulement</span>
        </button>
      </div>

      <div class="grid">
        <label>Prix de base du meuble (€)
          <input id="base" type="text" inputmode="decimal" autocomplete="off" placeholder="ex. 2400" />
        </label>
        <label>Poids total (kg)
          <input id="kg" type="text" inputmode="decimal" autocomplete="off" placeholder="0" />
        </label>
        <label>Coût des ouvriers (€)
          <input id="workers" type="text" inputmode="decimal" autocomplete="off" placeholder="0" />
        </label>
      </div>
      <p id="err" class="flash err" role="alert" hidden>Un des montants n’est pas un nombre (ex. 1250 ou 1 250,50).</p>
      <div class="actions">
        <button type="button" class="btn ghost" id="reset">Effacer</button>
      </div>
    </section>

    <section class="card result" aria-live="polite">
      <span class="muted">Prix final</span>
      <output id="total" class="money">—</output>
      <dl id="detail" hidden>
        <div><dt>Meuble (base + 10 %)</dt><dd id="d-meuble" class="money"></dd></div>
        <div><dt>Transport (1,50 € / kg)</dt><dd id="d-transport" class="money"></dd></div>
        <div id="row-marge1"><dt>Marge sur le matériel (15 %)</dt><dd id="d-marge1" class="money"></dd></div>
        <div><dt>Ouvriers</dt><dd id="d-ouvriers" class="money"></dd></div>
        <div><dt>Marge sur le total (15 %)</dt><dd id="d-marge2" class="money"></dd></div>
      </dl>
      <p id="hint" class="muted hint">Entrez au moins le prix de base.</p>
    </section>
  </div>
</Admin>

<style>
  .calc { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 720px) {
    .calc { grid-template-columns: 1.1fr 1fr; }
    .result { position: sticky; top: 4.5rem; }
  }
  .calc .card { margin: 0; }
  /* téléphone : le prix en haut, visible pendant qu'on tape */
  @media (max-width: 719px) { .result { order: -1; } }

  .types { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-bottom: 1rem; }
  .types button {
    display: grid; gap: .15rem; text-align: left; cursor: pointer; min-height: 44px;
    font: inherit; padding: .7rem .8rem; border-radius: 8px;
    border: 1px solid var(--a-line); background: var(--a-bg); color: var(--a-ink);
  }
  .types button span { font-size: .8rem; color: var(--a-muted); line-height: 1.3; }
  .types button[aria-pressed='true'] { border-color: var(--a-accent); background: var(--a-accent-soft); }
  .types button[aria-pressed='true'] strong { color: var(--a-accent); }

  input { font-size: 1.15rem; }
  input.invalid { border-color: var(--a-error); }
  #err { margin: .75rem 0 0; }

  .result { display: grid; gap: .25rem; }
  output { font-size: 2.3rem; font-weight: 700; line-height: 1.15; }
  dl { margin: .75rem 0 0; padding-top: .75rem; border-top: 1px solid var(--a-line); display: grid; gap: .4rem; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; font-size: .92rem; }
  dt { color: var(--a-soft); }
  dd { margin: 0; }
  dl div[hidden] { display: none; }
  .hint { margin: .3rem 0 0; font-size: .9rem; }
</style>

<script>
  // Coefficients — à modifier ici si les marges changent
  const MARGE_ACHAT = 1.1;   // base × 1.1
  const PRIX_PAR_KG = 1.5;   // 1,50 € par kg
  const MARGE = 1.15;        // 15 %

  // Type 1 : ((base × 1.1 + 1.5 × kg) × 1.15 + ouvriers) × 1.15
  // Type 2 : ((base × 1.1 + 1.5 × kg) + ouvriers) × 1.15
  function calc(type: number, base: number, kg: number, workers: number) {
    const meuble = base * MARGE_ACHAT;
    const transport = PRIX_PAR_KG * kg;
    const materiel = meuble + transport;
    const materielMarge = type === 1 ? materiel * MARGE : materiel;
    const sousTotal = materielMarge + workers;
    const total = sousTotal * MARGE;
    return { meuble, transport, marge1: materielMarge - materiel, marge2: total - sousTotal, total };
  }

  const eur = new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR' });
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const fields = ['base', 'kg', 'workers'].map((id) => $<HTMLInputElement>(id));
  const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('.types button')];
  let type = 1;

  // Accepte "12,5", "12.5" et "1 200,50" ; vide = 0 ; texte invalide = NaN
  function parse(input: HTMLInputElement): number {
    const raw = input.value.replace(/[\s ]/g, '').replace(',', '.');
    if (raw === '') return 0;
    if (!/^\d*\.?\d+$|^\d+\.$/.test(raw)) return NaN;
    return parseFloat(raw);
  }

  function update() {
    const values = fields.map((f) => {
      const v = parse(f);
      f.classList.toggle('invalid', Number.isNaN(v));
      return v;
    });
    const bad = values.some(Number.isNaN);
    $('err').hidden = !bad;
    const empty = fields[0].value.trim() === '';
    $('detail').hidden = bad || empty;
    $('hint').hidden = !(empty && !bad);
    if (bad || empty) {
      $('total').textContent = '—';
      return;
    }
    const [base, kg, workers] = values;
    const r = calc(type, base, kg, workers);
    $('total').textContent = eur.format(r.total);
    $('d-meuble').textContent = eur.format(r.meuble);
    $('d-transport').textContent = eur.format(r.transport);
    $('d-marge1').textContent = eur.format(r.marge1);
    $('row-marge1').hidden = type !== 1;
    $('d-ouvriers').textContent = eur.format(workers);
    $('d-marge2').textContent = eur.format(r.marge2);
  }

  typeButtons.forEach((btn) => btn.addEventListener('click', () => {
    type = Number(btn.dataset.type);
    typeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    update();
  }));
  fields.forEach((f) => f.addEventListener('input', update));
  $('reset').addEventListener('click', () => {
    fields.forEach((f) => { f.value = ''; f.classList.remove('invalid'); });
    update();
    fields[0].focus();
  });
</script>
