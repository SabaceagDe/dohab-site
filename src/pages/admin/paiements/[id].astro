---
// Détail d'une commande : chiffres, versements, ajout / modification.
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import OrderFields from '../../../components/admin/OrderFields.astro';
import PaymentFields from '../../../components/admin/PaymentFields.astro';
import { getOrder, listPayments } from '../../../lib/db';
import { id as parseId } from '../../../lib/forms';
import { formatEuros } from '../../../lib/money';

const db = Astro.locals.runtime.env.DB;
const orderId = parseId(Astro.params.id);
const order = orderId ? await getOrder(db, orderId) : null;
if (!order) return Astro.redirect('/admin/paiements?err=introuvable', 303);

const payments = await listPayments(db, order.id);
const rest = order.total_cents - order.paid_cents;
const methodLabel: Record<string, string> = { virement: 'Virement', cash: 'Cash', autre: 'Autre' };
const dateFr = (iso: string) => iso.split('-').reverse().join('/');
---
<Admin title={order.client_name} active="paiements">
  <p><a href="/admin/paiements">← Toutes les commandes</a></p>
  <h1>{order.client_name}</h1>
  <Flash />

  <section class="card">
    {order.label && <p class="lead">{order.label}</p>}
    <dl class="info">
      {order.client_phone && <><dt>Téléphone</dt><dd><a href={`tel:${order.client_phone}`}>{order.client_phone}</a></dd></>}
      {order.address && <><dt>Adresse</dt><dd>{order.address}</dd></>}
      {order.note && <><dt>Note</dt><dd class="note">{order.note}</dd></>}
    </dl>
    <div class="totals">
      <div><span class="muted">Total HTVA</span><strong class="money">{formatEuros(order.total_cents)}</strong></div>
      <div><span class="muted">Payé</span><strong class="money">{formatEuros(order.paid_cents)}</strong></div>
      <div>
        <span class="muted">{rest >= 0 ? 'Reste' : 'Trop-perçu'}</span>
        <strong class:list={['money', rest !== 0 && 'due', rest === 0 && 'ok']}>
          {rest === 0 ? 'Soldé' : formatEuros(Math.abs(rest))}
        </strong>
      </div>
    </div>
  </section>

  <section class="card">
    <h2>Versements</h2>
    {payments.length === 0 && <p class="muted">Aucun versement enregistré.</p>}
    <ul class="payments">
      {payments.map((p) => (
        <li>
          <details>
            <summary>
              <span class="when">{dateFr(p.paid_on)}</span>
              <span class="how muted">{p.method ? methodLabel[p.method] : ''}{p.note ? ` · ${p.note}` : ''}</span>
              <strong class="money">{formatEuros(p.amount_cents)}</strong>
            </summary>
            <form method="post" action="/admin/api/payments">
              <input type="hidden" name="order_id" value={order.id} />
              <input type="hidden" name="payment_id" value={p.id} />
              <PaymentFields payment={p} />
              <div class="actions">
                <button class="btn" type="submit" name="_action" value="update">Enregistrer</button>
                <button class="btn danger" type="submit" name="_action" value="delete" formnovalidate
                  data-confirm="Supprimer ce versement ?">Supprimer</button>
              </div>
            </form>
          </details>
        </li>
      ))}
    </ul>

    <details class="add" open={payments.length === 0 && rest > 0}>
      <summary>Ajouter un versement</summary>
      <form method="post" action="/admin/api/payments">
        <input type="hidden" name="_action" value="create" />
        <input type="hidden" name="order_id" value={order.id} />
        <PaymentFields />
        <div class="actions"><button class="btn" type="submit">Ajouter</button></div>
      </form>
    </details>
  </section>

  <details class="card">
    <summary>Modifier la commande</summary>
    <form method="post" action="/admin/api/orders">
      <input type="hidden" name="order_id" value={order.id} />
      <OrderFields order={order} />
      <div class="actions">
        <button class="btn" type="submit" name="_action" value="update">Enregistrer</button>
        <button class="btn danger" type="submit" name="_action" value="delete" formnovalidate
          data-confirm="Supprimer cette commande et la retirer de la liste ?">Supprimer la commande</button>
      </div>
    </form>
  </details>
</Admin>

<style>
  .lead { margin: 0 0 .75rem; font-weight: 500; }
  .info { display: grid; grid-template-columns: auto 1fr; gap: .3rem .9rem; margin: 0 0 1rem; font-size: .95rem; }
  .info dt { color: var(--a-muted); }
  .info dd { margin: 0; }
  .note { white-space: pre-wrap; }
  .totals { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; border-top: 1px solid var(--a-line); padding-top: .9rem; }
  .totals div { display: grid; gap: .15rem; }
  .totals .muted { font-size: .82rem; }
  .totals strong { font-size: 1.05rem; }
  .ok { color: var(--a-accent); }
  .payments { list-style: none; margin: 0 0 1rem; padding: 0; }
  .payments li { border-bottom: 1px solid var(--a-line); }
  .payments summary {
    display: grid; grid-template-columns: auto 1fr auto; gap: .75rem; align-items: baseline;
    padding: .7rem 0; font-weight: 400;
  }
  .payments summary::before { display: none; }
  .payments .how { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .9rem; }
  .payments form { padding: .25rem 0 1rem; }
  .add { margin-top: .5rem; }
</style>

<script>
  // Confirmation avant suppression (le bouton porte data-confirm).
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-confirm]');
    if (btn && !confirm(btn.dataset.confirm)) e.preventDefault();
  });
</script>
