---
// Rendue à chaque visite (et non plus au build) : la galerie et les prix
// viennent de la base, gérée dans /admin/realisations.
export const prerender = false;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import RoomTiles from '../components/RoomTiles.astro';
import Gallery from '../components/Gallery.astro';
import Feature from '../components/Feature.astro';
import Stairs from '../components/Stairs.astro';
import Finishes from '../components/Finishes.astro';
import Steps from '../components/Steps.astro';
import Prices from '../components/Prices.astro';
import Bois from '../components/Bois.astro';
import { loadVitrine } from '../lib/vitrine';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const locale = 'nl' as const;
const items = await loadVitrine(Astro.locals.runtime?.env?.DB);
const priced = items.filter((i) => i.price);
---
<Base locale={locale}>
  <Nav locale={locale} prix={priced.length > 0} />
  <main>
    <Hero locale={locale} />
    <RoomTiles locale={locale} />
    <Gallery locale={locale} items={items} />
    <Bois locale={locale} />

    <section class="band tint">
      <div class="wrap">
        <Feature locale={locale} prefix="feat1" photo="entree-noyer-banc.webp" />
        <Feature locale={locale} prefix="feat2" photo="cuisine-noyer-ilot-noir.webp" flip />
      </div>
    </section>

    <Stairs locale={locale} />
    <Finishes locale={locale} />
    <Steps locale={locale} />
    {priced.length > 0 && <Prices locale={locale} items={priced} />}
    <About locale={locale} photo="salon-panneau-chene.webp" />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
