---
/**
 * COMPOSANT DE RÉFÉRENCE.
 * Il montre le schéma utilisé partout ailleurs :
 *   1. le frontmatter (entre les ---) tourne au BUILD, sur le serveur ;
 *   2. le markup est généré une fois, en HTML statique ;
 *   3. le bloc script en bas part au navigateur et ne fait que du filtrage.
 * Aucune donnée ne transite par le réseau : tout est déjà dans la page.
 */
import type { Locale } from '../site.config';
import { t } from '../i18n';
import { projets, type Projet } from '../data/projets';
import auto from '../data/galerie-auto.json';
import { finitionById } from '../data/finitions';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
// tr() renvoie la clé elle-même quand la traduction manque ; ici on veut
// du vide à la place, pour les photos ajoutées sans texte
const trOu = (cle: string, sinon = '') => (tr(cle) === cle ? sinon : tr(cle));

// Deux sources : les réalisations écrites à la main (projets.ts, avec
// titre et description) et celles ajoutées par outils/galerie.py depuis
// le dossier de photos (galerie-auto.json). On les regroupe par pièce ;
// le tri est stable, donc dans chaque pièce les réalisations écrites à la
// main passent d'abord, puis les ajouts, du plus récent au plus ancien.
const ORDRE = ['cuisine', 'salon', 'dressing', 'bain'];
const tout: Projet[] = [...projets, ...(auto as Projet[])].sort(
  (a, b) => ORDRE.indexOf(a.room) - ORDRE.indexOf(b.room)
);
// sans titre traduit, une photo prend le nom de sa pièce
const titrePiece: Record<string, string> = {
  cuisine: 'filter.kitchen', dressing: 'filter.dressing', salon: 'filter.living', bain: 'filter.bath'
};
const titre = (p: Projet) => trOu(`${p.id}.t`, tr(titrePiece[p.room]));

const filters = [
  { room: 'all', key: 'filter.all' },
  { room: 'dressing', key: 'filter.dressing' },
  { room: 'cuisine', key: 'filter.kitchen' },
  { room: 'salon', key: 'filter.living' },
  { room: 'bain', key: 'filter.bath' }
];
---
<section class="band" id="work">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow rv">{tr('work.eyebrow')}</p>
        <h2 class="rv" style="--d:60ms">{tr('work.h2')}</h2>
      </div>
      <p class="lead rv" style="--d:120ms">{tr('work.sub')}</p>
    </div>

    <div class="filters rv">
      {filters.map((f) => (
        <button class="chip" type="button" data-room={f.room} aria-pressed={f.room === 'all'}>
          {tr(f.key)}
        </button>
      ))}
      <span class="active-color" id="activeColor">
        <span class="dot" id="acSw"></span>
        <span id="acName" style="font-size:var(--t-xs)"></span>
        <button class="x" type="button" id="acClear" aria-label="reset">&times;</button>
      </span>
    </div>

    <div class="gal" id="gal">
      {tout.map((p, i) => {
        const f = p.finish ? finitionById(p.finish) : undefined;
        return (
          <article
            class="card rv"
            data-room={p.room}
            data-finish={p.finish ?? ''}
            data-title={titre(p)}
            data-caption={trOu(`${p.id}.c`)}
            style={`--d:${(i % 4) * 80}ms`}>
            <div class="thumb">
              <img src={`/photos/${p.photo}`} alt={titre(p)} loading="lazy" />
            </div>
            <h3>{titre(p)}</h3>
            {f && (
              <div class="meta">
                <span class="dot" style={`background:${f.hex}`}></span>
                <span>{tr(`finish.${p.finish}`)}</span>
              </div>
            )}
          </article>
        );
      })}
    </div>

    <p class="empty" id="empty" style="display:none">{tr('work.empty')}</p>
  </div>
</section>

<script>
  // ---- filtrage : pièce (chips + tuiles) et teinte (pastilles) ----
  const gal = document.getElementById('gal')!;
  const cards = [...gal.querySelectorAll<HTMLElement>('.card')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const empty = document.getElementById('empty')!;
  const activeColor = document.getElementById('activeColor')!;

  let room = 'all';
  let finish: string | null = null;

  function apply() {
    let shown = 0;
    for (const c of cards) {
      const ok =
        (room === 'all' || c.dataset.room === room) &&
        (!finish || c.dataset.finish === finish);
      c.classList.toggle('hide', !ok);
      if (ok) shown++;
    }
    empty.style.display = shown ? 'none' : 'block';
    activeColor.classList.toggle('on', Boolean(finish));
  }

  function setRoom(next: string) {
    room = next;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.room === room)));
    apply();
  }

  chips.forEach((c) => c.addEventListener('click', () => setRoom(c.dataset.room!)));

  // les tuiles de pièce pilotent le même filtre
  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) =>
    tile.addEventListener('click', () => {
      setRoom(tile.dataset.room!);
      document.getElementById('work')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    })
  );

  // les pastilles de teinte
  const swatches = [...document.querySelectorAll<HTMLElement>('.fin')];
  swatches.forEach((s) =>
    s.addEventListener('click', () => {
      const id = s.dataset.finish!;
      finish = finish === id ? null : id;
      swatches.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.finish === finish)));
      if (finish) {
        (document.getElementById('acSw') as HTMLElement).style.background = s.dataset.hex!;
        document.getElementById('acName')!.textContent = s.dataset.name!;
        document.getElementById('work')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      apply();
    })
  );

  document.getElementById('acClear')!.addEventListener('click', () => {
    finish = null;
    swatches.forEach((x) => x.setAttribute('aria-pressed', 'false'));
    apply();
  });

  // ---- agrandissement au clic, et défilement d'une photo à l'autre ----
  const lb = document.getElementById('lb')!;
  const lbImg = document.getElementById('lbImg') as HTMLImageElement;
  const lbCap = document.getElementById('lbCap')!;
  const lbPrec = document.getElementById('lbPrec')!;
  const lbSuiv = document.getElementById('lbSuiv')!;

  // La liste est figée à l'ouverture : ce sont les fiches visibles à ce
  // moment-là. Ouvrir une cuisine avec le filtre « Cuisines » actif fait
  // donc défiler les cuisines, et seulement elles.
  let liste: HTMLElement[] = [];
  let pos = 0;

  const montrer = (i: number, sens: 0 | 1 | -1 = 0) => {
    pos = (i + liste.length) % liste.length;       // on boucle aux deux bouts
    const card = liste[pos];
    lbImg.src = card.querySelector('img')!.src;
    // titre en gras, description en dessous : le détail se lit une fois la
    // photo ouverte, pas dans la grille
    lbCap.innerHTML =
      `<strong>${card.dataset.title ?? ''}</strong><span>${card.dataset.caption ?? ''}</span>` +
      (liste.length > 1 ? `<em>${pos + 1} / ${liste.length}</em>` : '');
    // petit glissement dans le sens du geste ; relancer l'animation
    // demande de retirer la classe, forcer un recalcul, puis la remettre
    lbImg.classList.remove('vers-g', 'vers-d');
    if (sens) { void lbImg.offsetWidth; lbImg.classList.add(sens > 0 ? 'vers-g' : 'vers-d'); }
  };

  const fermer = () => lb.classList.remove('on');

  gal.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
    if (!card) return;
    liste = [...gal.querySelectorAll<HTMLElement>('.card:not(.hide)')];
    lb.classList.toggle('seule', liste.length < 2);
    montrer(Math.max(0, liste.indexOf(card)));
    lb.classList.add('on');
  });

  lbPrec.addEventListener('click', () => montrer(pos - 1, -1));
  lbSuiv.addEventListener('click', () => montrer(pos + 1, 1));

  lb.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    if (el === lb || el.id === 'lbClose') fermer();
  });
  addEventListener('keydown', (e) => {
    if (!lb.classList.contains('on')) return;
    if (e.key === 'Escape') fermer();
    if (e.key === 'ArrowRight') montrer(pos + 1, 1);
    if (e.key === 'ArrowLeft') montrer(pos - 1, -1);
  });

  // Au doigt : on glisse vers la gauche pour la suivante. Seul un geste
  // franchement horizontal compte, sinon un simple tapotement ou un
  // défilement vertical changerait de photo par accident.
  let x0 = 0, y0 = 0;
  lb.addEventListener('touchstart', (e) => {
    x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
  }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    const dy = e.changedTouches[0].clientY - y0;
    if (liste.length < 2 || Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
    dx < 0 ? montrer(pos + 1, 1) : montrer(pos - 1, -1);
  });

  // ---- ancres du menu : #work-cuisine descend ici et filtre ----
  // Une ancre plutôt qu'un clic JavaScript, pour que le lien fonctionne
  // aussi depuis les mentions légales, où la galerie n'existe pas encore.
  const PIECES = ['cuisine', 'dressing', 'salon', 'bain'];
  function depuisAncre(doux: boolean) {
    const m = location.hash.match(/^#work-([a-z]+)$/);
    if (!m || !PIECES.includes(m[1])) return;
    setRoom(m[1]);
    document.getElementById('work')!.scrollIntoView({
      behavior: doux ? 'smooth' : 'auto',
      block: 'start'
    });
  }
  addEventListener('hashchange', () => depuisAncre(true));
  depuisAncre(false);

  apply();
</script>
