---
/**
 * GALERIE DES RÉALISATIONS.
 * Les réalisations viennent de la base (gérées dans /admin/realisations) :
 * la page d'accueil les lit à chaque visite (lib/vitrine.ts) et les passe
 * ici. Ce composant ne fait que les afficher ; le script en bas filtre par
 * pièce et par teinte dans le navigateur, et ouvre la visionneuse.
 */
import type { Locale } from '../site.config';
import { t } from '../i18n';
import { finitionById } from '../data/finitions';
import { roomKey } from '../lib/realisations';
import { present, type PublicRealisation } from '../lib/vitrine';

// paquets : n'afficher que quelques lignes, avec « Voir plus » (version atelier)
interface Props { locale: Locale; items: PublicRealisation[]; paquets?: boolean }
const { locale, items, paquets = false } = Astro.props;
const tr = t(locale);

// un filtre par pièce présente dans la galerie, dans l'ordre du menu
const ordreFiltres = ['dressing', 'cuisine', 'salon', 'bain', 'escalier'] as const;
const filters = [
  { room: 'all', key: 'filter.all' },
  ...ordreFiltres.filter((r) => items.some((i) => i.room === r)).map((r) => ({ room: r, key: roomKey[r] }))
];
---
<section class="band" id="work">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow rv">{tr('work.eyebrow')}</p>
        <h2 class="rv" style="--d:60ms">{tr('work.h2')}</h2>
      </div>
      <p class="lead rv" style="--d:120ms">{tr('work.sub')}</p>
    </div>

    <div class="filters rv">
      {filters.map((f) => (
        <button class="chip" type="button" data-room={f.room} aria-pressed={f.room === 'all'}>
          {tr(f.key)}
        </button>
      ))}
      <span class="active-color" id="activeColor">
        <span class="dot" id="acSw"></span>
        <span id="acName" style="font-size:var(--t-xs)"></span>
        <button class="x" type="button" id="acClear" aria-label="reset">&times;</button>
      </span>
    </div>

    <div class="gal" id="gal" data-paquets={paquets ? "1" : undefined}>
      {items.map((r, i) => {
        const f = r.finish ? finitionById(r.finish) : undefined;
        const p = present(r, locale);
        return (
          <article
            class="card rv"
            data-room={r.room}
            data-finish={r.finish ?? ''}
            data-lb={p.lb}
            style={`--d:${(i % 4) * 80}ms`}>
            <div class="thumb">
              <img src={p.cover.thumb} alt={p.title} loading="lazy" decoding="async"
                width={p.cover.w ?? undefined} height={p.cover.h ?? undefined} />
              {r.photos.length > 1 && <span class="nb">+{r.photos.length - 1}</span>}
            </div>
            <h3>{p.title}</h3>
            {(f || p.price) && (
              <div class="meta">
                {f && <span class="dot" style={`background:${f.hex}`}></span>}
                {f && <span>{tr(`finish.${r.finish}`)}</span>}
                {p.price && <span class="prix">{p.price}</span>}
              </div>
            )}
          </article>
        );
      })}
    </div>

    <p class="empty" id="empty" style="display:none">{tr('work.empty')}</p>
    {/* on ne montre qu'une partie de la galerie ; le bouton en ajoute */}
    {paquets && (
      <div class="plus-wrap">
        <button type="button" class="btn line" id="galPlus" hidden data-left={tr('work.left')}>{tr('work.more')}</button>
      </div>
    )}
  </div>
</section>

<style>
  .thumb { position: relative; }
  .nb {
    position: absolute; right: .55rem; bottom: .55rem; padding: .2rem .5rem; border-radius: 999px;
    font-size: var(--t-xs); font-weight: 600; background: rgba(26, 24, 21, .62); color: #fff;
  }
  .plus-wrap { display: flex; justify-content: center; margin-top: clamp(1.4rem, 3vw, 2.2rem); }
  .prix { margin-left: auto; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
</style>

<script>
  import { openLightbox } from '../scripts/lightbox';

  // ---- filtrage : pièce (chips + tuiles) et teinte (pastilles) ----
  const gal = document.getElementById('gal')!;
  const cards = [...gal.querySelectorAll<HTMLElement>('.card')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const empty = document.getElementById('empty')!;
  const activeColor = document.getElementById('activeColor')!;

  let room = 'all';
  let finish: string | null = null;

  // Une galerie de 70 photos d'affilée, c'est un mur : on en montre une
  // rangée de quelques lignes, puis « Voir plus » en ajoute autant.
  const plus = document.getElementById('galPlus') as HTMLButtonElement | null;   // absent sur le site normal
  // sans data-paquets (site normal) : pas de limite, tout s'affiche
  const pas = () => (!gal.dataset.paquets ? Infinity : matchMedia('(max-width: 900px)').matches ? 8 : 12);
  // défilement doux de la version atelier s'il est chargé, sinon natif
  const allerA = (el: HTMLElement) => {
    const d = (window as unknown as { __defil?: { scrollTo(el: HTMLElement, o: object): void } | null }).__defil;
    const nav = document.querySelector<HTMLElement>('.nav');
    if (d) d.scrollTo(el, { offset: -((nav?.offsetHeight ?? 0) + 8), duration: 1.2 });
    else el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  let limite = pas();

  function apply() {
    let shown = 0;
    for (const c of cards) {
      const ok =
        (room === 'all' || c.dataset.room === room) &&
        (!finish || c.dataset.finish === finish);
      if (ok) shown++;
      // .hide = hors filtre (la visionneuse l'ignore) ; .cut = au-delà de la limite
      c.classList.toggle('hide', !ok || shown > limite);
    }
    empty.style.display = shown ? 'none' : 'block';
    activeColor.classList.toggle('on', Boolean(finish));
    if (plus) {
      const reste = shown - limite;
      // style="display" plutôt que hidden : la classe .btn l'emporterait sur [hidden]
      plus.style.display = reste > 0 ? '' : 'none';
      plus.textContent = `${plus.dataset.text ??= plus.textContent!.trim()} (${reste} ${plus.dataset.left})`;
    }
  }

  plus?.addEventListener('click', () => {
    const avant = gal.querySelectorAll('.card:not(.hide)').length;
    limite += pas();
    apply();
    // les nouvelles cartes arrivent en fondu, l'une après l'autre
    [...gal.querySelectorAll<HTMLElement>('.card:not(.hide)')].slice(avant).forEach((c, i) => {
      c.animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }],
        { duration: 500, delay: i * 40, easing: 'cubic-bezier(.2,.75,.2,1)', fill: 'backwards' });
    });
  });

  function setRoom(next: string) {
    limite = pas();
    room = next;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.room === room)));
    apply();
  }

  chips.forEach((c) => c.addEventListener('click', () => setRoom(c.dataset.room!)));

  // les tuiles de pièce pilotent le même filtre
  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) =>
    tile.addEventListener('click', () => {
      setRoom(tile.dataset.room!);
      allerA(document.getElementById('work')!);
    })
  );

  // les pastilles de teinte
  const swatches = [...document.querySelectorAll<HTMLElement>('.fin')];
  swatches.forEach((s) =>
    s.addEventListener('click', () => {
      const id = s.dataset.finish!;
      finish = finish === id ? null : id;
      limite = pas();
      swatches.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.finish === finish)));
      if (finish) {
        (document.getElementById('acSw') as HTMLElement).style.background = s.dataset.hex!;
        document.getElementById('acName')!.textContent = s.dataset.name!;
        allerA(document.getElementById('work')!);
      }
      apply();
    })
  );

  document.getElementById('acClear')!.addEventListener('click', () => {
    finish = null;
    swatches.forEach((x) => x.setAttribute('aria-pressed', 'false'));
    apply();
  });

  // ---- agrandissement au clic (visionneuse partagée avec « Prix ») ----
  // La liste est figée à l'ouverture : ce sont les fiches visibles à ce
  // moment-là. Ouvrir une cuisine avec le filtre « Cuisines » actif fait
  // donc défiler les cuisines, et seulement elles.
  gal.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
    if (!card) return;
    openLightbox([...gal.querySelectorAll<HTMLElement>('.card:not(.hide)')], card);
  });

  // ---- ancres du menu : #work-cuisine descend ici et filtre ----
  // Une ancre plutôt qu'un clic JavaScript, pour que le lien fonctionne
  // aussi depuis les mentions légales, où la galerie n'existe pas encore.
  const PIECES = ['cuisine', 'dressing', 'salon', 'bain', 'escalier'];
  function depuisAncre(doux: boolean) {
    const m = location.hash.match(/^#work-([a-z]+)$/);
    if (!m || !PIECES.includes(m[1])) return;
    setRoom(m[1]);
    const work = document.getElementById('work')!;
    if (doux) allerA(work);
    else work.scrollIntoView({ block: 'start' });
  }
  addEventListener('hashchange', () => depuisAncre(true));
  depuisAncre(false);

  apply();
</script>
