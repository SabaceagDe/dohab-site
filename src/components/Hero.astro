---
/**
 * HAUT DE PAGE — version « atelier » (expérience de style).
 *
 * Une photo plein écran qui change toute seule (fondu lent + léger zoom),
 * un grand titre fixe, et en bas un index des pièces : chaque entrée a sa
 * barre de progression ; quand elle est pleine, on passe à la pièce
 * suivante. Toucher une pièce l'affiche tout de suite et met à jour le
 * lien « Voir les cuisines / armoires… ».
 *
 * Sous le titre, une ligne de cote (comme sur un plan de menuisier) :
 * c'est le fil conducteur visuel du site — tout est fait sur mesure.
 *
 * Les photos viennent de src/data/heroSlides.ts (seules les diapos avec
 * `photo` sont utilisées ici). Pour mettre une photo de forêt en premier,
 * change l'ordre dans ce fichier (la forêt est en dernier).
 */
import type { Locale } from '../site.config';
import { t } from '../i18n';
import { diapos } from '../data/heroSlides';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const slides = diapos.filter((d) => d.photo);
// le titre arrive avec un <em> autour de sa seconde moitié : on en fait
// simplement une seconde ligne, sans changer de style
const titre = tr('hero.h1').replace('<em>', '<span class="l2">').replace('</em>', '</span>');
---
<section class="hero" id="hero" aria-label={tr('slide.role')}>
  <div class="hero-fonds" aria-hidden="true">
    {slides.map((d, i) => (
      <img class:list={['hero-fond', i === 0 && 'on']} alt=""
           src={d.photo!.startsWith('/') ? d.photo : `/photos/${d.photo}`}
           style={d.cadrage ? `--cadrage:${d.cadrage}` : undefined}
           loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
    ))}
  </div>

  <div class="hero-in wrap">
    {/* le bloc prend la largeur du titre : la cote mesure exactement le titre */}
    <div class="hero-bloc">
      <h1 class="hero-titre" set:html={titre} />
      <div class="cote" aria-hidden="true"><span>{tr('hero.eyebrow')}</span></div>
    </div>
    <p class="hero-sub">{tr('hero.sub')}</p>
    <div class="hero-cta">
      <a class="btn oak" href="#contact">{tr('hero.cta1')}</a>
      <a class="btn clair" id="heroVoir" href={slides[0].lien}>{tr(slides[0].cles.cta)}</a>
    </div>
  </div>

  <div class="hero-index wrap" role="group" aria-label={tr('slide.role')}>
    {slides.map((d, i) => (
      <button type="button" class="hi" data-i={i} data-lien={d.lien} data-cta={tr(d.cles.cta)}
              aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="hi-barre"><i></i></span>
        <span class="hi-nom">{tr(d.cles.eyebrow)}</span>
      </button>
    ))}
  </div>
</section>

<script>
  const hero = document.getElementById('hero');
  if (hero) {
    const fonds = [...hero.querySelectorAll<HTMLImageElement>('.hero-fond')];
    const items = [...hero.querySelectorAll<HTMLButtonElement>('.hi')];
    const voir = document.getElementById('heroVoir') as HTMLAnchorElement;
    let actif = 0;

    const montrer = (i: number) => {
      actif = (i + items.length) % items.length;
      fonds.forEach((f, j) => f.classList.toggle('on', j === actif));
      items.forEach((b, j) => b.setAttribute('aria-pressed', String(j === actif)));
      voir.href = items[actif].dataset.lien!;
      voir.textContent = items[actif].dataset.cta!;
      // la photo suivante se charge pendant qu'on regarde celle-ci
      const suivante = fonds[(actif + 1) % fonds.length];
      if (suivante.loading === 'lazy') suivante.loading = 'eager';
    };

    items.forEach((b, j) => b.addEventListener('click', () => montrer(j)));
    // La barre de la pièce active se remplit en CSS (4,8 s, en pause au
    // survol). Quand son animation se termine, on passe à la suivante :
    // pas de minuteur à synchroniser, et rien ne bouge si le système
    // demande de réduire les animations (l'animation n'existe pas).
    hero.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'hiPlein') montrer(actif + 1);
    });
    // onglet en arrière-plan : on ne fait pas défiler pour personne
    document.addEventListener('visibilitychange', () => hero.classList.toggle('pause', document.hidden));
  }
</script>
