---
/**
 * BANDE DÉFILANTE — version atelier seulement.
 * Les pièces qu'on fabrique, en très grandes lettres dessinées au trait, qui
 * défilent lentement ; entre deux mots, l'empreinte de cernes du logo.
 * La vitesse suit celle du défilement de la page (scripts/fx.ts).
 *
 * Purement décoratif : caché aux lecteurs d'écran (les mêmes pièces sont
 * déjà dans le menu), et immobile si le système demande de réduire les
 * animations. Les mots viennent des diapos du haut de page : ajouter une
 * pièce là-bas l'ajoute ici.
 */
import type { Locale } from '../site.config';
import { t } from '../i18n';
import { diapos } from '../data/heroSlides';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const mots = [tr('hero.eyebrow'), ...diapos.map((d) => tr(d.cles.eyebrow))];
---
<div class="ruban" aria-hidden="true">
  <div class="ruban-piste">
    {/* deux moitiés identiques : quand la première est sortie, la seconde
        est exactement à sa place et l'animation recommence sans raccord */}
    {[0, 1].map(() => (
      <div class="ruban-moitie">
        {mots.map((m, i) => (
          <span class:list={['ruban-mot', i === 0 && 'plein']}>{m}</span>
          <img src="/logo/cernes-fonce.webp" alt="" width="240" height="239" loading="lazy" decoding="async" />
        ))}
      </div>
    ))}
  </div>
</div>
