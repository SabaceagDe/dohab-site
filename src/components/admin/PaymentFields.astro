---
// Champs d'un versement (acompte, solde, ou tout paiement intermédiaire).
import { centsToInput } from '../../lib/money';
import { todayBrussels } from '../../lib/forms';
import type { PaymentRow } from '../../lib/db';

interface Props {
  payment?: PaymentRow;
  /** acompte facultatif dans « nouvelle commande » */
  optional?: boolean;
}
const { payment, optional = false } = Astro.props;
const method = payment?.method ?? 'virement';
---
<div class="grid two">
  <label>Montant HTVA (€) {optional && <span class="opt">(laisser vide si rien reçu)</span>}
    <input name="amount" required={!optional} inputmode="decimal" autocomplete="off" placeholder="ex. 3000"
      value={payment ? centsToInput(payment.amount_cents) : ''} />
  </label>
  <label>Date
    <input name="paid_on" type="date" required value={payment?.paid_on ?? todayBrussels()} />
  </label>
  <label>Moyen
    <select name="method">
      <option value="virement" selected={method === 'virement'}>Virement</option>
      <option value="cash" selected={method === 'cash'}>Cash</option>
      <option value="autre" selected={method === 'autre'}>Autre</option>
    </select>
  </label>
  <label>Note <span class="opt">(facultatif)</span>
    <input name="payment_note" maxlength="500" autocomplete="off" value={payment?.note ?? ''} />
  </label>
</div>
