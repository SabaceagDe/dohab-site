---
import { type Locale } from '../site.config';
import { t, locales, localeHref, legalHref } from '../i18n';

/**
 * page="home"  : on est sur l'accueil. Les liens de section sont de
 *                simples ancres (#work) et le sélecteur de langue mène
 *                à l'accueil de l'autre langue.
 * page="legal" : on est sur les mentions légales. Les ancres doivent
 *                repartir vers l'accueil (/fr/#work), sinon elles ne
 *                font rien, et le sélecteur de langue doit rester sur
 *                les mentions légales, sinon changer de langue fait
 *                perdre la page.
 */
// prix : la section « Prix » existe sur la page (au moins un prix affiché)
interface Props { locale: Locale; page?: 'home' | 'legal'; prix?: boolean }
const { locale, page = 'home', prix = false } = Astro.props;
const tr = t(locale);

const base = page === 'home' ? '' : localeHref(locale);
const ancre = (id: string) => `${base}#${id}`;
const versLangue = page === 'legal' ? legalHref : localeHref;
---
<header class="nav">
  <div class="wrap nav-in">
    {/* deux versions du logo : lettres foncées (fond clair) et claires (fond
        sombre) ; le CSS affiche celle qui convient (global.css / atelier.css) */}
    <a class="brand" href={localeHref(locale)}>
      <img class="logo logo-fonce" src="/logo/dohab-mark-fonce.webp" alt="DO HAB" width="760" height="184" />
      <img class="logo logo-clair" src="/logo/dohab-mark-clair.webp" alt="" width="760" height="184" />
    </a>
    <nav class="nav-links">
      {/* Le menu annonce des pièces, pas des sections : un clic descend à
          la galerie ET applique le filtre. Le "-cuisine" de l'ancre est lu
          par Gallery.astro ; il survit à un changement de page, ce qu'un
          simple data-attribut n'aurait pas fait. */}
      <a href={ancre('work-cuisine')}>{tr('filter.kitchen')}</a>
      <a href={ancre('work-dressing')}>{tr('filter.dressing')}</a>
      <a href={ancre('work-salon')}>{tr('filter.living')}</a>
      <a href={ancre('work-bain')}>{tr('filter.bath')}</a>
      <a href={ancre('escaliers')}>{tr('nav.stairs')}</a>
      {prix && <a href={ancre('prix')}>{tr('nav.prices')}</a>}
      <a href={ancre('about')}>{tr('nav.about')}</a>
    </nav>

    {/* De vraies URL, plus un bouton JavaScript : chaque langue est
        une page que Google peut indexer séparément. */}
    <div class="lang">
      {locales.map((l) => (
        <a
          href={versLangue(l)}
          aria-current={l === locale ? 'page' : undefined}
          data-active={l === locale}>{l.toUpperCase()}</a>
      ))}
    </div>

    <a class="btn sm" href={ancre('contact')}>{tr('nav.cta')}</a>
  </div>
</header>
