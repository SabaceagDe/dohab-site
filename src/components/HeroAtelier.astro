---
/**
 * HAUT DE PAGE — version « atelier » (expérience de style).
 *
 * Une photo plein écran qui change toute seule (passage dessiné en WebGL,
 * voir scripts/hero-gl.ts ; simple fondu si le navigateur ne peut pas),
 * une phrase courte par photo, et en bas un index des pièces : chaque entrée a sa
 * barre de progression ; quand elle est pleine, on passe à la pièce
 * suivante. Toucher une pièce l'affiche tout de suite et met à jour le
 * lien « Voir les cuisines / armoires… ».
 *
 * Les photos viennent de src/data/heroSlides.ts (seules les diapos avec
 * `photo` sont utilisées ici), puis la forêt, ajoutée juste en dessous.
 */
import type { Locale } from '../site.config';
import { t } from '../i18n';
import { diapos } from '../data/heroSlides';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
// les pièces d'abord (cuisine en tête), la forêt en dernier
const slides = [
  ...diapos.filter((d) => d.photo),
  { id: 'foret', photo: '/foret/sous-bois.webp', lien: '#work',
    cles: { eyebrow: 'sl0.eyebrow', titre: 'hero.h1', sub: '', cta: 'hero.cta2' } }
];
// Chaque photo a sa phrase courte (les mêmes que sur le site normal :
// « Votre cuisine, en mieux. »). Le titre arrive avec un <em> autour de sa
// seconde moitié : on en fait simplement une seconde ligne.
const lignes = (cle: string) => tr(cle).replace('<em>', '<span class="l2">').replace('</em>', '</span>');
---
<section class="hero" id="hero" aria-label={tr('slide.role')}>
  <div class="hero-fonds" aria-hidden="true">
    {slides.map((d, i) => (
      <img class:list={['hero-fond', i === 0 && 'on']} alt=""
           src={d.photo!.startsWith('/') ? d.photo : `/photos/${d.photo}`}
           style={d.cadrage ? `--cadrage:${d.cadrage}` : undefined}
           loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
    ))}
  </div>

  <div class="hero-in wrap">
    {/* Les titres sont empilés au même endroit ; seul celui de la photo
        affichée est visible (.on). Le premier est le <h1> de la page. */}
    <div class="hero-bloc">
      <div class="hero-titres">
        {slides.map((d, i) => i === 0
          ? <h1 class="hero-titre on" set:html={lignes(d.cles.titre)} />
          : <h2 class="hero-titre" aria-hidden="true" set:html={lignes(d.cles.titre)} />)}
      </div>
    </div>
    <div class="hero-subs">
      {slides.map((d, i) => (
        <p class:list={['hero-sub', i === 0 && 'on']} aria-hidden={i === 0 ? undefined : 'true'}>{d.cles.sub ? tr(d.cles.sub) : ''}</p>
      ))}
    </div>
    <div class="hero-cta">
      <a class="btn oak" href="#contact">{tr('hero.cta1')}</a>
      <a class="btn clair" id="heroVoir" href={slides[0].lien}>{tr(slides[0].cles.cta)}</a>
    </div>
  </div>

  <div class="hero-index wrap" role="group" aria-label={tr('slide.role')}>
    {slides.map((d, i) => (
      <button type="button" class="hi" data-i={i} data-lien={d.lien} data-cta={tr(d.cles.cta)}
              aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="hi-barre"><i></i></span>
        <span class="hi-nom">{tr(d.cles.eyebrow)}</span>
      </button>
    ))}
  </div>
</section>

<script>
  import { rideau } from '../scripts/hero-gl';

  const hero = document.getElementById('hero');
  if (hero) {
    const fonds = [...hero.querySelectorAll<HTMLImageElement>('.hero-fond')];
    const items = [...hero.querySelectorAll<HTMLButtonElement>('.hi')];
    const voir = document.getElementById('heroVoir') as HTMLAnchorElement;
    const titres = [...hero.querySelectorAll<HTMLElement>('.hero-titre')];
    const subs = [...hero.querySelectorAll<HTMLElement>('.hero-sub')];
    let actif = 0;
    // passage d'une photo à l'autre dessiné en WebGL (scripts/hero-gl.ts) ;
    // null si le navigateur ne peut pas : il reste alors le fondu des <img>
    const gl = rideau(hero, fonds);

    const montrer = (i: number) => {
      actif = (i + items.length) % items.length;
      fonds.forEach((f, j) => f.classList.toggle('on', j === actif));
      gl?.aller(actif);
      items.forEach((b, j) => b.setAttribute('aria-pressed', String(j === actif)));
      // la phrase de la photo affichée (les autres sont cachées, aussi aux lecteurs d'écran)
      for (const liste of [titres, subs]) liste.forEach((el, j) => {
        el.classList.toggle('on', j === actif);
        if (j === actif) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
      });
      voir.href = items[actif].dataset.lien!;
      voir.textContent = items[actif].dataset.cta!;
      ajusterNav();
      // la photo suivante se charge pendant qu'on regarde celle-ci
      const suivante = fonds[(actif + 1) % fonds.length];
      if (suivante.loading === 'lazy') suivante.loading = 'eager';
      // … et se décode à l'avance, pour que le fondu ne saccade pas
      suivante.decode?.().catch(() => {});
    };

    // Barre du haut lisible sur toutes les photos : on mesure la luminosité
    // de la bande du haut de chaque photo (réduite à 48 px de large dans un
    // <canvas>) ; au-dessus d'une photo claire, la barre passe en texte foncé.
    const nav = document.querySelector<HTMLElement>('.nav');
    const clarte = new Map<HTMLImageElement, boolean>();
    const estClaire = (img: HTMLImageElement): boolean | null => {
      if (clarte.has(img)) return clarte.get(img)!;
      if (!img.complete || !img.naturalWidth) return null;
      const w = 48;
      const h = Math.max(1, Math.round((w * img.naturalHeight) / img.naturalWidth));
      const c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      const ctx = c.getContext('2d', { willReadFrequently: true })!;
      ctx.drawImage(img, 0, 0, w, h);
      // la bande où se trouvent les liens : le haut de la photo, de 30 % à 90 % de la largeur
      const px = ctx.getImageData(Math.round(w * 0.3), 0, Math.round(w * 0.6), Math.max(1, Math.round(h * 0.14))).data;
      let somme = 0;
      for (let k = 0; k < px.length; k += 4) somme += 0.2126 * px[k] + 0.7152 * px[k + 1] + 0.0722 * px[k + 2];
      const claire = somme / (px.length / 4) / 255 > 0.56;
      clarte.set(img, claire);
      return claire;
    };
    const ajusterNav = () => {
      const img = fonds[actif];
      const claire = estClaire(img);
      if (claire === null) return img.addEventListener('load', ajusterNav, { once: true });
      nav?.classList.toggle('sur-clair', claire);
    };

    items.forEach((b, j) => b.addEventListener('click', () => montrer(j)));
    ajusterNav();
    // La barre de la pièce active se remplit en CSS (4,8 s, en pause au
    // survol). Quand son animation se termine, on passe à la suivante :
    // pas de minuteur à synchroniser, et rien ne bouge si le système
    // demande de réduire les animations (l'animation n'existe pas).
    hero.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'hiPlein') montrer(actif + 1);
    });
    // onglet en arrière-plan, ou haut de page sorti de l'écran : on ne fait
    // défiler pour personne (la barre de progression se met en pause)
    let horsVue = false;
    const pause = () => hero.classList.toggle('pause', document.hidden || horsVue);
    document.addEventListener('visibilitychange', pause);
    new IntersectionObserver(([e]) => { horsVue = !e.isIntersecting; pause(); }).observe(hero);
  }
</script>
