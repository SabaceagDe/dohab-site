---
import { site, type Locale } from '../site.config';
import { t } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);

// Clé publique Web3Forms. Elle est faite pour vivre dans la page :
// elle n'autorise qu'une chose, envoyer vers l'adresse liée au compte
// (info@dohab.be). Changer de destinataire se fait sur web3forms.com,
// pas ici. Vider cette chaîne remet le formulaire en démonstration.
const WEB3FORMS_KEY = '55f5f6c3-39f2-4cfd-8a22-44618077d37c';
---
<section class="band tint" id="contact">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow rv">{tr('contact.eyebrow')}</p>
        <h2 class="rv" style="--d:60ms">{tr('contact.h2')}</h2>
      </div>
      <p class="lead rv" style="--d:120ms">{tr('contact.sub')}</p>
    </div>

    <div class="contact">
      <form id="form" class="rv" novalidate
            data-key={WEB3FORMS_KEY}
            data-subject={`${tr('form.subject')} — ${site.name}`}
            data-sending={tr('form.sending')}
            data-ok={tr('form.ok')}
            data-invalid={tr('form.invalid')}
            data-error={tr('form.error')}>
        <div class="two">
          <div class="field">
            <label for="n">{tr('form.name')}</label>
            <input id="n" name="name" type="text" autocomplete="name" />
          </div>
          <div class="field">
            <label for="e">{tr('form.email')}</label>
            <input id="e" name="email" type="email" autocomplete="email" />
          </div>
        </div>
        <div class="two">
          <div class="field">
            <label for="tel">{tr('form.phone')}</label>
            <input id="tel" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="ty">{tr('form.type')}</label>
            <select id="ty" name="type">
              <option>{tr('filter.dressing')}</option>
              <option>{tr('filter.kitchen')}</option>
              <option>{tr('filter.living')}</option>
              <option>{tr('filter.bath')}</option>
              <option>{tr('form.other')}</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="m">{tr('form.msg')}</label>
          <textarea id="m" name="message" rows="5"></textarea>
        </div>

        {/* piège à robots : invisible pour un humain, rempli par les bots */}
        <input type="text" name="botcheck" tabindex="-1" autocomplete="off"
               style="position:absolute;left:-9999px" aria-hidden="true" />

        <button class="btn" type="submit">{tr('form.send')}</button>
        <p class="form-note">{tr('form.note')}</p>
        <p class="sent" id="sent" role="status" aria-live="polite"></p>
      </form>

      <div class="direct">
        <a href={site.whatsapp}>
          <span><span class="k">{tr('direct.wa')}</span><span class="v">{site.phone}</span></span>
          <span class="arw">&rarr;</span>
        </a>
        <a href={site.phoneHref}>
          <span><span class="k">{tr('direct.call')}</span><span class="v">{site.phone}</span></span>
          <span class="arw">&rarr;</span>
        </a>
        <a href={`mailto:${site.email}`}>
          <span><span class="k">{tr('direct.mail')}</span><span class="v">{site.email}</span></span>
          <span class="arw">&rarr;</span>
        </a>
        <div class="zone">
          <span class="k">{tr('direct.zone')}</span><span>{tr('direct.zonev')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Envoi via Web3Forms : pas de serveur à nous, la demande part
  // directement du navigateur vers leur API, qui la relaie par e-mail.
  const form = document.getElementById('form') as HTMLFormElement | null;
  const sent = document.getElementById('sent');
  const btn = form?.querySelector('button[type=submit]') as HTMLButtonElement | null;

  // messages : ils viennent des data-* du formulaire, donc traduits
  const msg = (kind: 'sending' | 'ok' | 'invalid' | 'error') => {
    if (!sent || !form) return;
    sent.textContent = form.dataset[kind] ?? '';
    sent.classList.add('on');
    sent.classList.toggle('bad', kind === 'invalid' || kind === 'error');
  };

  const EMAIL = /^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/;

  // Renvoie true si tout est rempli, et souligne en rouge ce qui manque.
  const valide = () => {
    if (!form) return false;
    let ok = true;
    for (const nom of ['name', 'email', 'message']) {
      const el = form.elements.namedItem(nom) as HTMLInputElement;
      const vide = !el.value.trim();
      const mauvais = vide || (nom === 'email' && !EMAIL.test(el.value.trim()));
      el.closest('.field')?.classList.toggle('bad', mauvais);
      if (mauvais) ok = false;
    }
    return ok;
  };

  // on enlève le liseré rouge dès que la personne corrige
  form?.addEventListener('input', (e) => {
    (e.target as HTMLElement).closest('.field')?.classList.remove('bad');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    const cle = form.dataset.key;
    if (!cle) { msg('ok'); return; }          // pas de clé : mode maquette

    if (!valide()) { msg('invalid'); return; }

    const data = new FormData(form);
    data.append('access_key', cle);
    data.append('subject', form.dataset.subject ?? 'Nouvelle demande');
    data.append('from_name', String(data.get('name') ?? ''));
    // contexte utile dans l'e-mail : langue et page d'origine
    data.append('langue', document.documentElement.lang);
    data.append('page', location.href);

    btn && (btn.disabled = true);
    msg('sending');

    try {
      const r = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data
      });
      const rep = await r.json().catch(() => ({}));
      if (r.ok && rep.success) {
        form.reset();
        msg('ok');
      } else {
        msg('error');
      }
    } catch {
      msg('error');                            // hors ligne, ou requête bloquée
    } finally {
      btn && (btn.disabled = false);
    }
  });
</script>
