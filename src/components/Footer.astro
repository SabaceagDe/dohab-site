---
import { site, type Locale } from '../site.config';
import { t, legalHref } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-in">
      <div>
        <b>{site.name}</b>
        <p style="margin-top:.6rem">{tr('foot.tag')}</p>
      </div>
      <div>
        <span class="k">{tr('foot.nav')}</span>
        <ul>
          <li><a href="#work">{tr('nav.work')}</a></li>
          <li><a href="#finitions">{tr('nav.colors')}</a></li>
          <li><a href="#process">{tr('nav.process')}</a></li>
          <li><a href="#contact">{tr('nav.contact')}</a></li>
        </ul>
      </div>
      <div>
        <span class="k">{tr('foot.legalh')}</span>
        <ul>
          <li>{site.street}, {site.postcode} {site.city}</li>
          <li>{site.vat}</li>
          <li>{site.phone}</li>
          <li>{site.email}</li>
          <li><a href={legalHref(locale)}>{tr('legal.footlink')}</a></li>
        </ul>
      </div>
    </div>
    <p class="legal">{tr('foot.legal')}</p>
  </div>
</footer>

<div class="lb" id="lb" role="dialog" aria-modal="true">
  <button class="close" id="lbClose" aria-label={tr('lb.close')}>&times;</button>
  {/* pas de src="" ici : un src vide fait recharger la page elle-même
      comme si c'était une image. C'est Gallery.astro qui le remplit. */}
  <img id="lbImg" alt="" />
  {/* flèches : parcourent les photos actuellement visibles dans la
      galerie, donc seulement les cuisines si le filtre cuisine est actif */}
  <button class="lb-fleche prec" id="lbPrec" type="button" aria-label={tr('lb.prev')}>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none">
      <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button class="lb-fleche suiv" id="lbSuiv" type="button" aria-label={tr('lb.next')}>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none">
      <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div class="cap" id="lbCap"></div>
</div>
