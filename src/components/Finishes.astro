---
import type { Locale } from '../site.config';
import { t } from '../i18n';
import { finitions } from '../data/finitions';
// bois : photo de rondins à côté des teintes (version atelier seulement)
interface Props { locale: Locale; bois?: boolean }
const { locale, bois = false } = Astro.props;
const tr = t(locale);
---
<section class="band" id="finitions">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow rv">{tr('colors.eyebrow')}</p>
        <h2 class="rv" style="--d:60ms">{tr('colors.h2')}</h2>
      </div>
      <p class="lead rv" style="--d:120ms">{tr('colors.sub')}</p>
    </div>

    {/* version atelier : à gauche, du vrai bois ; à droite, les teintes */}
    <div class:list={[bois && 'finis-cadre']}>
    {bois && (
      <div class="finis-bois rv-img">
        <img src="/foret/rondins-bouleau.webp" alt={tr('bois.alt')} loading="lazy" decoding="async"
             width="1000" height="1511" />
      </div>
    )}
    <div>
    <div class="finis">
      {finitions.map((f, i) => (
        <button
          class="fin rv"
          type="button"
          data-finish={f.id}
          data-hex={f.hex}
          data-name={tr(`finish.${f.id}`)}
          aria-pressed="false"
          style={`--d:${i * 40}ms`}>
          <span class="swatch" style={`background:${f.hex}`}></span>
          <span class="n">{tr(`finish.${f.id}`)}</span>
        </button>
      ))}
    </div>

    <p class="note rv">{tr('colors.note')}</p>
    </div>
    </div>
  </div>
</section>
